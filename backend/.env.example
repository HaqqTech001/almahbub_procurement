# Runtime
NODE_ENV=development
PORT=5000

# Security
# Generate a unique value of at least 32 characters. Never commit real values.
JWT_SECRET=replace-with-a-unique-32-character-minimum-secret
# Comma-separated browser origins. CLIENT_URL remains supported for one origin.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Debug routes are disabled by default. When enabled, they require an admin JWT.
ENABLE_DEBUG_EMAIL_ROUTES=false

# Database (legacy MySQL reference only)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=almahbub_procurement
DB_USER=replace-me
DB_PASSWORD=replace-me
