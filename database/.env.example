# Application connections use DATABASE_URL. Prisma migrations use a direct or
# session-pooler URL, while the shadow URL must target a separate non-production
# database.
DATABASE_URL=postgresql://hamd:change-this-local-password@127.0.0.1:5432/hamd_development
MIGRATION_DATABASE_URL=postgresql://hamd:change-this-local-password@127.0.0.1:5432/hamd_development
SHADOW_DATABASE_URL=postgresql://hamd:change-this-local-password@127.0.0.1:5432/hamd_shadow
