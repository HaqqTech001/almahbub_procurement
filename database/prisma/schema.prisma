/// Rule/keyword knowledge base - V1 /ai parity.
model KnowledgeArticle {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  authorId       String?       @map("author_id") @db.Uuid
  question       String
  answer         String
  keywords       String[]      @default([])
  active         Boolean       @default(true)
  hitCount       Int           @default(0) @map("hit_count")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  author         User?         @relation("KnowledgeArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([active, updatedAt(sort: Desc)])
  @@map("knowledge_articles")
}

model MarketingInquiry {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  userId         String?       @map("user_id") @db.Uuid
  name           String
  email          String        @db.Citext
  company        String?
  subject        String?
  message        String
  status         String        @default("new")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@map("marketing_inquiries")
}

model PlatformService {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  name           String
  slug           String        @unique @db.Citext
  summary        String?
  body           String?
  status         String        @default("active")
  sortOrder      Int           @default(0) @map("sort_order")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([status, sortOrder])
  @@map("platform_services")
}

/// Almahbub Integrated Export commodity catalogue (IE-11A).
/// Isolated from International Product / ProductCategory.
/// Category is optional free-text until an approved IE category taxonomy exists — do not reuse ProductCategory.
/// Media fields store path/alt references only (no binary duplication). Soft-archive via archivedAt.
model IntegratedExportCommodity {
  id                 String    @id @default(uuid(7)) @db.Uuid
  slug               String    @unique @db.Citext
  name               String
  /// Public catalogue gate. Defaults to draft (false).
  published          Boolean   @default(false)
  /// Optional free-text category label — not a ProductCategory FK.
  category           String?
  shortDescription   String?   @map("short_description")
  description        String?
  /// { src, alt, caption, stage } - admin-uploaded or verified media references.
  heroMedia          Json?     @map("hero_media") @db.JsonB
  /// [{ src, alt, caption, stage, sortOrder }]
  gallery            Json?     @db.JsonB
  /// [{ label, value }]
  specifications     Json?     @db.JsonB
  packaging          String?
  qualityInformation String?   @map("quality_information")
  /// string[]
  applications       Json?     @db.JsonB
  markets            String?
  sortOrder          Int       @default(0) @map("sort_order")
  archivedAt         DateTime? @map("archived_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([published, sortOrder])
  @@index([archivedAt])
  @@map("integrated_export_commodities")
}

enum WeddingStreamStatus {
  draft
  upcoming
  live
  ended
  archived
}

/// Single-event Rowdotul HAMD'26 campaign. Overlay JSON holds invitation copy.
model WeddingCampaign {
  id           String              @id
  slug         String              @unique
  streamStatus WeddingStreamStatus @default(upcoming) @map("stream_status")
  overlay      Json                @db.JsonB
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  comments      WeddingComment[]
  gallery       WeddingGalleryItem[]
  recording     WeddingRecording?
  waitingTracks WeddingWaitingTrack[]

  @@map("wedding_campaigns")
}

model WeddingWaitingTrack {
  id                String          @id @default(uuid(7)) @db.Uuid
  weddingCampaignId String          @map("wedding_campaign_id")
  campaign          WeddingCampaign @relation(fields: [weddingCampaignId], references: [id], onDelete: Cascade)
  title             String
  caption           String          @default("")
  storageKey        String          @map("storage_key")
  src               String
  mimeType          String          @map("mime_type")
  fileSize          Int             @map("file_size")
  durationSeconds   Float?          @map("duration_seconds")
  position          Int             @default(0)
  isEnabled         Boolean         @default(true) @map("is_enabled")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  @@index([weddingCampaignId, position])
  @@map("wedding_waiting_tracks")
}

model WeddingComment {
  id          String          @id @default(uuid(7)) @db.Uuid
  campaignId  String          @map("campaign_id")
  campaign    WeddingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId      String          @map("user_id") @db.Uuid
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  message     String
  hidden      Boolean         @default(false)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz

  @@index([campaignId, createdAt])
  @@map("wedding_comments")
}

model WeddingGalleryItem {
  id           String          @id @default(uuid(7)) @db.Uuid
  campaignId   String          @map("campaign_id")
  campaign     WeddingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  kind         String
  src          String
  storageKey   String          @map("storage_key")
  title        String
  caption      String          @default("")
  featured     Boolean         @default(false)
  downloadable Boolean         @default(false)
  sortOrder    Int             @default(0) @map("sort_order")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz

  @@index([campaignId, sortOrder])
  @@map("wedding_gallery_items")
}

model WeddingRecording {
  id            String              @id @default(uuid(7)) @db.Uuid
  campaignId    String              @unique @map("campaign_id")
  campaign      WeddingCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  storageKey    String              @map("storage_key")
  publicUrl     String?             @map("public_url")
  durationSeconds Int?              @map("duration_seconds")
  sizeBytes     Int?                @map("size_bytes")
  mimeType      String              @map("mime_type")
  status        String
  downloadable  Boolean             @default(false)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  @@map("wedding_recordings")
}
