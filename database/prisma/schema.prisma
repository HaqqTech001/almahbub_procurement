enum GuidanceMode {
  off
  guided
  training
}

enum GuidanceTourStatus {
  draft
  published
  archived
  scheduled
}

enum GuidanceProgressStatus {
  not_started
  in_progress
  completed
  skipped
}

enum GuidanceAudience {
  client_workspace
  operations_console
  supplier_portal
  mobile
  all_authenticated
}

model GuidanceTour {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String?            @map("organization_id") @db.Uuid
  key            String
  title          String
  description    String?
  audience       GuidanceAudience   @default(all_authenticated)
  pageKey        String             @map("page_key")
  status         GuidanceTourStatus @default(draft)
  mandatory      Boolean            @default(false)
  estimatedMinutes Int              @default(5) @map("estimated_minutes")
  locale         String             @default("en")
  sortOrder      Int                @default(0) @map("sort_order")
  scheduledFor   DateTime?          @map("scheduled_for") @db.Timestamptz
  publishedAt    DateTime?          @map("published_at") @db.Timestamptz
  rowVersion     Int                @default(0) @map("row_version")
  createdById    String?            @map("created_by_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  organization   Organization?      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy      User?              @relation("GuidanceTourAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  steps          GuidanceTourStep[]
  progress       GuidanceUserProgress[]

  @@unique([organizationId, key, locale])
  @@index([status, audience, pageKey])
  @@map("guidance_tours")
}

model GuidanceTourStep {
  id              String       @id @default(uuid(7)) @db.Uuid
  tourId          String       @map("tour_id") @db.Uuid
  stepKey         String       @map("step_key")
  title           String
  body            String
  targetSelector  String?      @map("target_selector")
  placement       String       @default("auto")
  requireAction   Boolean      @default(false) @map("require_action")
  actionEvent     String?      @map("action_event")
  actionLabel     String?      @map("action_label")
  imageHref       String?      @map("image_href")
  sortOrder       Int          @default(0) @map("sort_order")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  tour            GuidanceTour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([tourId, stepKey])
  @@index([tourId, sortOrder])
  @@map("guidance_tour_steps")
}

model GuidanceTip {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  key            String
  featureKey     String        @map("feature_key")
  pageKey        String        @map("page_key")
  title          String
  body           String
  targetSelector String?       @map("target_selector")
  locale         String        @default("en")
  enabled        Boolean       @default(true)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  dismissals     GuidanceTipDismissal[]

  @@unique([organizationId, key, locale])
  @@index([pageKey, featureKey, enabled])
  @@map("guidance_tips")
}

model GuidanceUserPreference {
  id                 String       @id @default(uuid(7)) @db.Uuid
  userId             String       @map("user_id") @db.Uuid
  organizationId     String?      @map("organization_id") @db.Uuid
  mode               GuidanceMode @default(guided)
  neverAutoStart     Boolean      @default(false) @map("never_auto_start")
  welcomeCompletedAt DateTime?    @map("welcome_completed_at") @db.Timestamptz
  locale             String       @default("en")
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@map("guidance_user_preferences")
}

model GuidanceUserProgress {
  id              String                 @id @default(uuid(7)) @db.Uuid
  userId          String                 @map("user_id") @db.Uuid
  organizationId  String?                @map("organization_id") @db.Uuid
  tourId          String                 @map("tour_id") @db.Uuid
  status          GuidanceProgressStatus @default(not_started)
  currentStepKey  String?                @map("current_step_key")
  completedSteps  Int                    @default(0) @map("completed_steps")
  totalSteps      Int                    @default(0) @map("total_steps")
  startedAt       DateTime?              @map("started_at") @db.Timestamptz
  completedAt     DateTime?              @map("completed_at") @db.Timestamptz
  skippedAt       DateTime?              @map("skipped_at") @db.Timestamptz
  lastActiveAt    DateTime               @default(now()) @map("last_active_at") @db.Timestamptz
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tour            GuidanceTour           @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([userId, tourId])
  @@index([userId, status])
  @@map("guidance_user_progress")
}

model GuidanceTipDismissal {
  id        String      @id @default(uuid(7)) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  tipId     String      @map("tip_id") @db.Uuid
  dismissedAt DateTime  @default(now()) @map("dismissed_at") @db.Timestamptz
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tip       GuidanceTip @relation(fields: [tipId], references: [id], onDelete: Cascade)

  @@unique([userId, tipId])
  @@map("guidance_tip_dismissals")
}

/// Platform announcements - V1 announcements parity (RC7).
model Announcement {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String?            @map("organization_id") @db.Uuid
  title          String
  slug           String             @unique @db.Citext
  summary        String?
  body           String
  status         String             @default("published")
  publishedAt    DateTime?          @map("published_at") @db.Timestamptz
  pinned         Boolean            @default(false)
  scheduledFor   DateTime?          @map("scheduled_for") @db.Timestamptz
  expiresAt      DateTime?          @map("expires_at") @db.Timestamptz
  viewCount      Int                @default(0) @map("view_count")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  organization   Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  media          AnnouncementMedia[]
  replies        AnnouncementReply[]
  reactions      AnnouncementReaction[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([pinned, publishedAt(sort: Desc)])
  @@map("announcements")
}

/// V1 announcement media_files join: images, video, and documents via StoredDocument.
model AnnouncementMedia {
  id             String         @id @default(uuid(7)) @db.Uuid
  announcementId String         @map("announcement_id") @db.Uuid
  documentId     String         @map("document_id") @db.Uuid
  sortOrder      Int            @default(0) @map("sort_order")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  announcement   Announcement   @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  document       StoredDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([announcementId, documentId])
  @@index([documentId])
  @@index([announcementId, sortOrder])
  @@map("announcement_media")
}

model AnnouncementReply {
  id             String       @id @default(uuid(7)) @db.Uuid
  announcementId String       @map("announcement_id") @db.Uuid
  authorUserId   String       @map("author_user_id") @db.Uuid
  body           String
  hiddenAt       DateTime?    @map("hidden_at") @db.Timestamptz
  hiddenByUserId String?      @map("hidden_by_user_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  author         User         @relation("AnnouncementReplyAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  hiddenBy       User?        @relation("AnnouncementReplyModerator", fields: [hiddenByUserId], references: [id], onDelete: SetNull)

  @@index([announcementId, createdAt])
  @@index([authorUserId])
  @@map("announcement_replies")
}

model AnnouncementReaction {
  id             String       @id @default(uuid(7)) @db.Uuid
  announcementId String       @map("announcement_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  emoji          String
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([announcementId, userId, emoji])
  @@index([announcementId])
  @@index([userId])
  @@map("announcement_reactions")
}

