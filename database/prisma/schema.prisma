generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  pending_verification
  active
  suspended
  deactivated
}

enum OrganizationStatus {
  pending
  active
  suspended
  archived
}

enum MembershipStatus {
  invited
  active
  suspended
  removed
}

enum RoleScope {
  platform
  organization
}

enum SessionStatus {
  active
  revoked
  expired
}

enum LoginEventType {
  sign_in
  sign_out
  sign_in_failed
  mfa_challenge
  mfa_success
  mfa_failure
}

enum LoginEventOutcome {
  success
  failure
  blocked
}

enum ProductStatus {
  draft
  published
  archived
}

enum SupplierStatus {
  draft
  active
  suspended
  archived
}

enum ProcurementRequestStatus {
  draft
  submitted
  needs_clarification
  accepted_for_sourcing
  sourcing
  quote_issued
  revision_requested
  approved
  declined
  expired
  purchase_in_progress
  fulfilled
  cancelled
  closed
}

enum ProcurementRequestPriority {
  low
  normal
  high
  urgent
}

/// Authoritative line-of-business for procurement requests.
/// Existing historical rows migrate to `international`.
enum ProcurementRequestLob {
  international
  integrated_export
}

enum QuotationStatus {
  draft
  internally_reviewed
  issued
  accepted
  declined
  expired
  superseded
}

enum PurchaseOrderStatus {
  draft
  issued
  partially_fulfilled
  fulfilled
  cancelled
  closed
}

enum InvoiceStatus {
  draft
  issued
  paid
  partially_paid
  overdue
  voided
}

enum PaymentStatus {
  draft
  requested
  initiated
  pending_confirmation
  confirmed
  allocated
  settled
  failed
  refunded
  voided
  disputed
}

enum PaymentMethod {
  manual_bank_transfer
}

enum ShipmentStatus {
  planned
  supplier_ready
  inspection_pending
  pickup_scheduled
  picked_up
  export_cleared
  departed
  transshipment
  arrived
  import_cleared
  warehouse_received
  quality_checked
  dispatched
  out_for_delivery
  delivered
  completed
  cancelled
  held
  returned
  lost
}

enum ShipmentMilestoneType {
  po_confirmed
  supplier_ready
  inspection_booked
  inspection_passed
  inspection_failed
  pickup_scheduled
  picked_up
  export_cleared
  departed
  transshipment
  arrived
  import_cleared
  warehouse_arrival
  quality_checked
  dispatched
  out_for_delivery
  delivery_attempted
  delivered
  delivery_confirmed
  completed
  exception_opened
}

enum MilestoneConfidence {
  confirmed
  probable
  estimated
  unverified
}

enum ShipmentInspectionStatus {
  pending
  passed
  conditional_pass
  failed
  not_required
}

enum NotificationType {
  account
  procurement
  quotation
  invoice
  payment
  shipment
  announcement
  support
  system
  security
}

enum NotificationPriority {
  critical
  high
  normal
  low
}

enum NotificationStatus {
  unread
  read
  archived
  deleted
  expired
}

enum NotificationChannel {
  in_app
  email
  sms
  push
}

enum NotificationDeliveryStatus {
  planned
  sent
  delivered
  failed
  suppressed
  expired
}

enum CommunicationTemplateStatus {
  draft
  published
  archived
}

enum OutboxEventStatus {
  pending
  processing
  published
  dead_lettered
}

model User {
  id                          String                          @id @default(uuid(7)) @db.Uuid
  email                       String                          @unique @db.Citext
  status                      UserStatus                      @default(pending_verification)
  firstName                   String                          @map("first_name")
  lastName                    String                          @map("last_name")
  displayName                 String?                         @map("display_name")
  locale                      String                          @default("en")
  timeZone                    String?                         @map("time_zone")
  emailVerifiedAt             DateTime?                       @map("email_verified_at") @db.Timestamptz
  lastAuthenticatedAt         DateTime?                       @map("last_authenticated_at") @db.Timestamptz
  tokenVersion                Int                             @default(0) @map("token_version")
  createdAt                   DateTime                        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                   DateTime                        @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt                   DateTime?                       @map("deleted_at") @db.Timestamptz
  memberships                 OrganizationMembership[]
  credentials                 UserCredential?
  sessions                    UserSession[]
  devices                     Device[]
  loginEvents                 LoginEvent[]
  identities                  UserIdentityProvider[]
  verificationTokens          EmailVerificationToken[]
  resetTokens                 PasswordResetToken[]
  mfaTotp                     UserMfaTotp?
  recoveryCodes               UserRecoveryCode[]
  invitations                 OrganizationInvitation[]        @relation("InvitationCreator")
  procurementRequests         ProcurementRequest[]            @relation("ProcurementRequester")
  procurementAssignments      ProcurementRequestAssignment[]  @relation("ProcurementAssignee")
  procurementStatusEvents     ProcurementRequestStatusEvent[] @relation("ProcurementStatusActor")
  quotationHistory            QuotationHistory[]              @relation("QuotationHistoryActor")
  invoiceHistory              InvoiceHistory[]                @relation("InvoiceHistoryActor")
  createdPayments             Payment[]                       @relation("PaymentCreator")
  confirmedPayments           Payment[]                       @relation("PaymentConfirmer")
  paymentHistory              PaymentHistory[]                @relation("PaymentHistoryActor")
  shipmentConfirmations       Shipment[]                      @relation("ShipmentConfirmedBy")
  shipmentHistory             ShipmentHistory[]               @relation("ShipmentHistoryActor")
  archivedProcurementRequests ProcurementRequest[]            @relation("ProcurementArchivedBy")
  auditEvents                 AuditEvent[]                    @relation("AuditActor")
  receivedNotifications       Notification[]                  @relation("NotificationRecipient")
  notificationPreferences     NotificationPreference[]
  authoredTemplates           CommunicationTemplate[]         @relation("CommunicationTemplateAuthor")
  publishedTemplateVersions   CommunicationTemplateVersion[]  @relation("CommunicationTemplatePublisher")
  guidancePreferences         GuidanceUserPreference[]
  guidanceProgress            GuidanceUserProgress[]
  guidanceTipDismissals       GuidanceTipDismissal[]
  authoredGuidanceTours       GuidanceTour[]                  @relation("GuidanceTourAuthor")
  supportThreads              SupportThread[]                 @relation("SupportThreadRequester")
  supportMessages             SupportMessage[]                @relation("SupportMessageAuthor")
  knowledgeArticlesAuthored   KnowledgeArticle[]              @relation("KnowledgeArticleAuthor")
  marketingInquiries          MarketingInquiry[]
  uploadedDocuments           StoredDocument[]                @relation("DocumentUploader")
  announcementReplies         AnnouncementReply[]             @relation("AnnouncementReplyAuthor")
  hiddenAnnouncementReplies   AnnouncementReply[]             @relation("AnnouncementReplyModerator")
  announcementReactions       AnnouncementReaction[]
  weddingComments             WeddingComment[]

  @@index([status, createdAt(sort: Desc)])
  @@map("users")
}

model UserCredential {
  userId       String   @id @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  algorithm    String   @default("argon2id")
  rotatedAt    DateTime @default(now()) @map("rotated_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_credentials")
}

model UserIdentityProvider {
  id              String   @id @default(uuid(7)) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  provider        String
  providerSubject String   @map("provider_subject")
  providerEmail   String?  @map("provider_email") @db.Citext
  emailVerified   Boolean  @default(false) @map("email_verified")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  user            User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("user_identity_providers")
}

model Organization {
  id                  String                   @id @default(uuid(7)) @db.Uuid
  legalName           String                   @map("legal_name")
  displayName         String                   @map("display_name")
  slug                String                   @unique @db.Citext
  status              OrganizationStatus       @default(pending)
  countryCode         String?                  @map("country_code") @db.Char(2)
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt           DateTime?                @map("deleted_at") @db.Timestamptz
  memberships         OrganizationMembership[]
  roles               Role[]
  invitations         OrganizationInvitation[]
  procurementRequests ProcurementRequest[]
  quotations          Quotation[]
  quotationFamilies   QuotationFamily[]
  purchaseOrders      PurchaseOrder[]
  invoices            Invoice[]
  payments            Payment[]
  shipments           Shipment[]
  auditEvents         AuditEvent[]
  outboxEvents        OutboxEvent[]
  eventConsumerInboxEntries EventConsumerInbox[]
  deadLetterEvents    DeadLetterEvent[]
  notifications       Notification[]
  notificationEvents  NotificationEvent[]
  notificationPreferences NotificationPreference[]
  communicationTemplates CommunicationTemplate[]
  guidanceTours          GuidanceTour[]
  guidanceTips           GuidanceTip[]
  announcements          Announcement[]
  supportThreads         SupportThread[]
  knowledgeArticles      KnowledgeArticle[]
  marketingInquiries     MarketingInquiry[]
  platformServices       PlatformService[]
  storedDocuments        StoredDocument[]

  @@index([status, createdAt(sort: Desc)])
  @@map("organizations")
}

model ProductCategory {
  id              String            @id @default(uuid(7)) @db.Uuid
  parentId        String?           @map("parent_id") @db.Uuid
  name            String
  slug            String            @unique @db.Citext
  status          ProductStatus     @default(draft)
  description     String?
  imageUrl        String?           @map("image_url")
  imageAlt        String?           @map("image_alt")
  imageStorageKey String?           @map("image_storage_key")
  imageMimeType   String?           @map("image_mime_type")
  imageBytes      Int?              @map("image_bytes")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  parent    ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  ProductCategory[] @relation("CategoryTree")
  products  Product[]

  @@index([parentId, status])
  @@map("product_categories")
}

model Product {
  id             String            @id @default(uuid(7)) @db.Uuid
  categoryId     String?           @map("category_id") @db.Uuid
  brandId        String?           @map("brand_id") @db.Uuid
  manufacturerId String?           @map("manufacturer_id") @db.Uuid
  name           String
  slug           String            @unique @db.Citext
  description    String?
  status         ProductStatus     @default(draft)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  category       ProductCategory?  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand          Brand?            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  manufacturer   Manufacturer?     @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  variants       ProductVariant[]
  images         ProductImage[]
  videos         ProductVideo[]
  downloads      ProductDownload[]

  @@index([categoryId, status])
  @@index([brandId])
  @@index([manufacturerId])
  @@map("products")
}

model Brand {
  id        String    @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String    @unique @db.Citext
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  products  Product[]

  @@map("brands")
}

model Manufacturer {
  id          String    @id @default(uuid(7)) @db.Uuid
  legalName   String    @map("legal_name")
  countryCode String?   @map("country_code") @db.Char(2)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  products    Product[]

  @@unique([legalName, countryCode])
  @@map("manufacturers")
}

model ProductImage {
  id         String   @id @default(uuid(7)) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  url        String
  storageKey String?  @map("storage_key")
  mimeType   String?  @map("mime_type")
  fileSize   Int?     @map("file_size")
  altText    String?  @map("alt_text")
  caption    String?
  position   Int      @default(0)
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([productId, position])
  @@map("product_images")
}

model ProductVideo {
  id        String   @id @default(uuid(7)) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String
  title     String?
  caption   String?
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([productId, position])
  @@index([productId])
  @@map("product_videos")
}

model ProductDownload {
  id        String   @id @default(uuid(7)) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  title     String
  url       String
  mimeType  String   @map("mime_type")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@map("product_downloads")
}

model ProductVariant {
  id             String                   @id @default(uuid(7)) @db.Uuid
  productId      String                   @map("product_id") @db.Uuid
  sku            String?                  @unique
  name           String
  specifications Json?                    @db.JsonB
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz
  product        Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  requestItems   ProcurementRequestItem[]
  quotationItems QuotationItem[]

  @@index([productId])
  @@map("product_variants")
}

model Supplier {
  id             String            @id @default(uuid(7)) @db.Uuid
  legalName      String            @map("legal_name")
  status         SupplierStatus    @default(draft)
  countryCode    String?           @map("country_code") @db.Char(2)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  contacts       SupplierContact[]
  quotations     Quotation[]
  purchaseOrders PurchaseOrder[]

  @@index([status, legalName])
  @@map("suppliers")
}

model SupplierContact {
  id         String   @id @default(uuid(7)) @db.Uuid
  supplierId String   @map("supplier_id") @db.Uuid
  name       String
  email      String?  @db.Citext
  phone      String?
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([supplierId])
  @@map("supplier_contacts")
}

model ProcurementRequest {
  id                      String                          @id @default(uuid(7)) @db.Uuid
  organizationId          String                          @map("organization_id") @db.Uuid
  requesterId             String                          @map("requester_id") @db.Uuid
  publicCode              String                          @map("public_code")
  status                  ProcurementRequestStatus        @default(draft)
  /// Line of business. Defaults to international for backward compatibility.
  lob                     ProcurementRequestLob           @default(international)
  title                   String
  currencyCode            String                          @default("USD") @map("currency_code") @db.Char(3)
  notes                   String?
  destinationCountryCode  String?                         @map("destination_country_code") @db.Char(2)
  destinationAddress      String?                         @map("destination_address")
  requiredByDate          DateTime?                       @map("required_by_date") @db.Date
  budgetAmount            Decimal?                        @map("budget_amount") @db.Decimal(18, 2)
  priority                ProcurementRequestPriority      @default(normal)
  restrictedGoodsDeclared Boolean                         @default(false) @map("restricted_goods_declared")
  rowVersion              Int                             @default(0) @map("row_version")
  archivedAt              DateTime?                       @map("archived_at") @db.Timestamptz
  archivedById            String?                         @map("archived_by_id") @db.Uuid
  duplicatedFromId        String?                         @map("duplicated_from_id") @db.Uuid
  createdAt               DateTime                        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime                        @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt               DateTime?                       @map("deleted_at") @db.Timestamptz
  organization            Organization                    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requester               User                            @relation("ProcurementRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  archivedBy              User?                           @relation("ProcurementArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  duplicatedFrom          ProcurementRequest?             @relation("ProcurementRequestDuplicate", fields: [duplicatedFromId], references: [id], onDelete: SetNull)
  duplicates              ProcurementRequest[]            @relation("ProcurementRequestDuplicate")
  items                   ProcurementRequestItem[]
  assignments             ProcurementRequestAssignment[]
  statusEvents            ProcurementRequestStatusEvent[]
  documents               ProcurementRequestDocument[]
  quotations              Quotation[]
  quotationFamilies       QuotationFamily[]
  purchaseOrders          PurchaseOrder[]

  @@unique([organizationId, publicCode])
  @@index([organizationId, status, createdAt(sort: Desc)])
  @@index([organizationId, requesterId, createdAt(sort: Desc)])
  @@index([organizationId, deletedAt, status, createdAt(sort: Desc)])
  @@index([organizationId, lob, createdAt(sort: Desc)])
  @@map("procurement_requests")
}

model ProcurementRequestAssignment {
  id                   String                 @id @default(uuid(7)) @db.Uuid
  procurementRequestId String                 @map("procurement_request_id") @db.Uuid
  membershipId         String                 @map("membership_id") @db.Uuid
  assignedById         String                 @map("assigned_by_id") @db.Uuid
  isPrimary            Boolean                @default(true) @map("is_primary")
  assignedAt           DateTime               @default(now()) @map("assigned_at") @db.Timestamptz
  unassignedAt         DateTime?              @map("unassigned_at") @db.Timestamptz
  request              ProcurementRequest     @relation(fields: [procurementRequestId], references: [id], onDelete: Restrict)
  membership           OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  assignedBy           User                   @relation("ProcurementAssignee", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([procurementRequestId, unassignedAt])
  @@index([membershipId, unassignedAt])
  @@map("procurement_request_assignments")
}

model ProcurementRequestStatusEvent {
  id                   String                    @id @default(uuid(7)) @db.Uuid
  procurementRequestId String                    @map("procurement_request_id") @db.Uuid
  fromStatus           ProcurementRequestStatus? @map("from_status")
  toStatus             ProcurementRequestStatus  @map("to_status")
  command              String
  reason               String?
  actorId              String                    @map("actor_id") @db.Uuid
  rowVersion           Int                       @map("row_version")
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  request              ProcurementRequest        @relation(fields: [procurementRequestId], references: [id], onDelete: Restrict)
  actor                User                      @relation("ProcurementStatusActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([procurementRequestId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@map("procurement_request_status_events")
}

model StoredDocument {
  id               String                       @id @default(uuid(7)) @db.Uuid
  organizationId   String                       @map("organization_id") @db.Uuid
  uploadedById     String                       @map("uploaded_by_id") @db.Uuid
  originalFilename String                       @map("original_filename")
  storedFilename   String                       @map("stored_filename")
  mimeType         String                       @map("mime_type")
  sizeBytes        Int                          @map("size_bytes")
  storageProvider  String                       @default("local") @map("storage_provider")
  storagePath      String                       @map("storage_path")
  checksumSha256   String?                      @map("checksum_sha256")
  createdAt        DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  deletedAt        DateTime?                    @map("deleted_at") @db.Timestamptz
  organization     Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  uploadedBy       User                         @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  procurementLinks ProcurementRequestDocument[]
  announcementLinks AnnouncementMedia[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([uploadedById, createdAt(sort: Desc)])
  @@map("stored_documents")
}

model ProcurementRequestDocument {
  id                   String             @id @default(uuid(7)) @db.Uuid
  procurementRequestId String             @map("procurement_request_id") @db.Uuid
  documentId           String             @map("document_id") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz
  request              ProcurementRequest @relation(fields: [procurementRequestId], references: [id], onDelete: Cascade)
  document             StoredDocument     @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([procurementRequestId, documentId])
  @@index([documentId])
  @@map("procurement_request_documents")
}

model AuditEvent {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  actorId        String?      @map("actor_id") @db.Uuid
  action         String
  resourceType   String       @map("resource_type")
  resourceId     String       @map("resource_id") @db.Uuid
  requestId      String?      @map("request_id")
  metadata       Json?        @db.JsonB
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor          User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, resourceType, resourceId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@map("audit_events")
}

model OutboxEvent {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  aggregateType  String       @map("aggregate_type")
  aggregateId    String       @map("aggregate_id") @db.Uuid
  eventType      String       @map("event_type")
  eventName      String?      @map("event_name")
  eventVersion   Int          @default(1) @map("event_version")
  actorId        String?      @map("actor_id") @db.Uuid
  correlationId  String?      @map("correlation_id")
  causationId    String?      @map("causation_id")
  metadata       Json?        @db.JsonB
  payload        Json         @db.JsonB
  occurredAt     DateTime     @default(now()) @map("occurred_at") @db.Timestamptz
  publishedAt    DateTime?    @map("published_at") @db.Timestamptz
  status         OutboxEventStatus @default(pending)
  availableAt    DateTime     @default(now()) @map("available_at") @db.Timestamptz
  leaseToken     String?      @map("lease_token")
  leasedUntil    DateTime?    @map("leased_until") @db.Timestamptz
  attempts       Int          @default(0)
  lastError      String?      @map("last_error")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  notificationEvents NotificationEvent[]
  consumerInboxEntries EventConsumerInbox[]
  deadLetters    DeadLetterEvent[]

  @@index([publishedAt, occurredAt])
  @@index([status, availableAt])
  @@index([leaseToken, leasedUntil])
  @@index([organizationId, aggregateType, aggregateId, occurredAt])
  @@map("outbox_events")
}

model EventConsumerInbox {
  id            String      @id @default(uuid(7)) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  outboxEventId String      @map("outbox_event_id") @db.Uuid
  consumerName  String      @map("consumer_name")
