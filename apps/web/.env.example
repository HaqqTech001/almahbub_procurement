# Public website (@hamd/web)
VITE_SITE_URL=http://127.0.0.1:3000
# Leave unset in local dev so cookie auth uses same-origin `/api` (Vite proxies to :4000).
# Pointing this at :4000 makes POST /auth/refresh cross-site; SameSite=Lax cookies
# are omitted and the API returns 403 CSRF_VALIDATION_FAILED.
# Same-machine Chrome: http://127.0.0.1:3000
# Phone/tablet on LAN: http://<this-pc-lan-ip>:3000 (Vite listens on 0.0.0.0).
# Do not open http://localhost on the phone — that is the phone, not this PC.
# VITE_API_URL=http://127.0.0.1:4000
# Optional Notification Center WebSocket. When unset or unreachable, the host polls GET /notifications.
# VITE_NOTIFICATIONS_WS_URL=ws://127.0.0.1:4000/ws/notifications
# Master kill-switch for site announcements (false = hide all campaigns)
VITE_CAMPAIGNS_ENABLED=true
# Set true to preview time-gated campaigns outside their window (local only)
VITE_PREVIEW_CAMPAIGNS=false
# Public Google GIS client ID (never a client secret).
# Authorized JavaScript origins in Google Cloud must be exact page origins:
#   http://127.0.0.1:3000
#   http://localhost:3000
# Do not add /login or :3001 for the buyer site.
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
