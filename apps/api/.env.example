NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173
# Set to 1 (or more) when the API sits behind a reverse proxy / load balancer.
TRUST_PROXY=0
# Optional override for Secure cookies (defaults to true when NODE_ENV=production).
# COOKIE_SECURE=true
DATABASE_URL=postgresql://hamd:change-this-local-password@127.0.0.1:5432/hamd_development
REDIS_URL=redis://127.0.0.1:6379
# Generate a unique high-entropy value of at least 32 characters; never commit a real value.
JWT_ACCESS_SECRET=replace-with-a-unique-32-character-minimum-secret
JWT_ISSUER=hamd-api
JWT_AUDIENCE=hamd-client
ACCESS_TOKEN_TTL_SECONDS=900
# Opaque refresh tokens are HTTP-only cookies, rotated on every refresh.
REFRESH_TOKEN_TTL_SECONDS=2592000
# Required in production for centralized transactional email delivery.
RESEND_API_KEY=re_replace_with_resend_api_key
EMAIL_FROM=notifications@example.com
# Public web origin used in verify-email and reset-password links.
APP_PUBLIC_URL=http://localhost:5173
# Lock account after N failed sign-ins inside the window (server-side).
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_WINDOW_SECONDS=900

# Local disk root for procurement request attachments (V1 parity).
UPLOAD_ROOT=uploads

# AI_DEFAULT_PROVIDER=none selects the first available key among the providers below.
AI_DEFAULT_PROVIDER=none
# OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL=claude-sonnet-4-20250514
# GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-2.0-flash
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name
