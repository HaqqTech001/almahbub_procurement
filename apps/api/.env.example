NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173
# Development also reflects private LAN origins (192.168/10/172.16-31) so phones can
# open http://<pc-lan-ip>:3000 without listing every DHCP address. Production still
# uses this explicit list only.
# Set to 1 (or more) when the API sits behind a reverse proxy / load balancer.
TRUST_PROXY=0
# Optional override for Secure cookies (defaults to true when NODE_ENV=production).
# COOKIE_SECURE=true
DATABASE_URL=postgresql://hamd:change-this-local-password@127.0.0.1:5432/hamd_development
REDIS_URL=redis://127.0.0.1:6379
# Generate a unique high-entropy value of at least 32 characters; never commit a real value.
JWT_ACCESS_SECRET=replace-with-a-unique-32-character-minimum-secret
JWT_ISSUER=hamd-api
JWT_AUDIENCE=hamd-client
ACCESS_TOKEN_TTL_SECONDS=3600
# Opaque refresh tokens are HTTP-only cookies, rotated on every refresh.
# Default 7 days so buyers stay signed in across browser restarts.
REFRESH_TOKEN_TTL_SECONDS=604800
# Required in production for centralized transactional email delivery.
RESEND_API_KEY=re_replace_with_resend_api_key
EMAIL_FROM=notifications@example.com
EMAIL_FROM_NAME=Almahbub International
# Optional. Reply-To and footer contact (defaults to almahbubinternational@gmail.com).
# EMAIL_REPLY_TO=almahbubinternational@gmail.com
# EMAIL_CONTACT=almahbubinternational@gmail.com
# Public logo URL for HTML email (PNG/JPG recommended). Defaults to {APP_PUBLIC_URL}/almahbub.svg
# EMAIL_LOGO_URL=https://your-production-origin/almahbub.svg
# Local/dev: Resend is used automatically when RESEND_API_KEY + EMAIL_FROM are set.
# EMAIL_PROVIDER is accepted as an alias for AUTH_EMAIL_PROVIDER (trim whitespace).
# AUTH_EMAIL_PROVIDER=console
# AUTH_EMAIL_PROVIDER=resend
# Public web origin used in verify-email and reset-password links.
APP_PUBLIC_URL=http://localhost:5173
# Google Sign-In (GIS ID-token). Client ID only — do not put a secret in VITE_*.
# GOOGLE_CLIENT_ID=
# Legacy authorization-code redirect (optional; needs the server secret).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:4000/api/v1/auth/google/callback
# Lock account after N failed sign-ins inside the window (server-side).
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_WINDOW_SECONDS=900

# Local disk root for private procurement attachments (V1 StoredDocument).
# Catalogue photos use CATALOG_MEDIA_DRIVER independently.
# `local` is development-only and is rejected when NODE_ENV=production.
UPLOAD_ROOT=uploads
CATALOG_MEDIA_DRIVER=local

# --- Production catalogue media (choose ONE driver) ---
# S3 / S3-compatible:
# CATALOG_MEDIA_DRIVER=s3
# CATALOG_MEDIA_S3_BUCKET=almahbub-catalog-public
# AWS_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional CDN or public bucket origin (defaults to https://{bucket}.s3.{region}.amazonaws.com):
# CATALOG_MEDIA_S3_PUBLIC_BASE_URL=https://cdn.example.com

# Supabase Storage (public bucket; service role is server-side only):
# CATALOG_MEDIA_DRIVER=supabase
# CATALOG_MEDIA_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# CATALOG_MEDIA_SUPABASE_SERVICE_ROLE_KEY=
# CATALOG_MEDIA_SUPABASE_BUCKET=catalog-public
# Optional Playwright live Ops CRUD (never commit real passwords):
# LiveKit (server only — never expose API key/secret to the browser).
# Local docker compose service `livekit` uses the documented --dev keys:
#   docker compose up -d livekit
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
# Production / LiveKit Cloud:
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# WEDDING_TEST_CONTROLS=true

# AI_DEFAULT_PROVIDER=none selects the first available key among the providers below.
AI_DEFAULT_PROVIDER=none
# OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL=claude-sonnet-4-20250514
# GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-2.0-flash
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name
