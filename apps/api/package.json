{
  "name": "@hamd/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "dispatch:notifications": "tsx src/workers/notification-dispatcher.ts",
    "email:preview": "tsx src/modules/communication/email/preview-emails.ts",
    "lint": "eslint src test",
    "typecheck": "tsc --project tsconfig.test.json",
    "test": "vitest run",
    "db:generate": "echo \"Prisma is introduced in the Prisma module.\"",
    "db:migrate": "echo \"Prisma is introduced in the Prisma module.\"",
    "db:studio": "echo \"Prisma is introduced in the Prisma module.\""
  },
  "dependencies": {
    "@hamd/constants": "workspace:*",
    "@hamd/contracts": "workspace:*",
    "@hamd/database": "workspace:*",
    "@hamd/env": "workspace:*",
    "@hamd/types": "workspace:*",
    "@hamd/utils": "workspace:*",
    "argon2": "0.45.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.4",
    "livekit-server-sdk": "2.13.3",
    "otplib": "^13.4.1",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "resend": "^6.18.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@hamd/config-eslint": "workspace:*",
    "@hamd/config-typescript": "workspace:*",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.35.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
