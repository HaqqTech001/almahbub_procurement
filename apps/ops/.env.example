# Operations console (@hamd/ops)
# Ops users need ops:access. Public registration no longer grants it.
# Grant an existing user:
#   OPS_GRANT_EMAIL=you@example.com corepack pnpm --filter @hamd/api exec tsx src/scripts/grant-ops-access.ts
# Reconcile accidental buyer ops:access (dry-run by default):
#   corepack pnpm --filter @hamd/api exec tsx src/scripts/reconcile-ops-access.ts
# Playwright live CRUD against a real Ops account (do not commit values):
# HAMD_OPS_E2E_EMAIL=
# HAMD_OPS_E2E_PASSWORD=
# Optional buyer account used only to prove Admin remains forbidden:
# HAMD_BUYER_E2E_EMAIL=
# HAMD_BUYER_E2E_PASSWORD=
VITE_SITE_URL=http://127.0.0.1:3001
# Public/buyer web origin used by Ops preview links (wedding rehearsal, etc.).
VITE_PUBLIC_WEB_URL=http://127.0.0.1:3000
# Leave unset in local dev so auth uses same-origin `/api` (Vite proxies to :4000).
# That keeps httpOnly refresh cookies on the ops origin. Do not point this at :4000
# locally — cross-origin POST /auth/refresh drops SameSite=Lax cookies and returns 403.
# Same-machine Chrome: http://127.0.0.1:3001
# LAN device: http://<this-pc-lan-ip>:3001
# VITE_API_URL=http://127.0.0.1:4000
# Optional Notification Center WebSocket. When unset or unreachable, the host polls GET /notifications.
# VITE_NOTIFICATIONS_WS_URL=ws://127.0.0.1:4000/ws/notifications
